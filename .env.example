# Copy to .env and fill in. Never commit .env.

# Public site URL (no trailing slash)
SITE_URL=https://okieheatingandcooling.com

# Where new service requests are emailed
ADMIN_EMAIL=info@okieheatingandcooling.com
# "From" address for outgoing mail (must be a mailbox/domain you control on Hostinger)
SENDER_EMAIL=email@okieheatingandcooling.com
# Optional BCC copy of every email
BCC_EMAIL=

# Brevo transactional API key (https://app.brevo.com/settings/keys/api)
# Leave empty to send with PHP mail() instead.
BREVO_API_KEY=

# MySQL (optional). Create DB in hPanel -> Databases, import sql/schema.sql.
# Leave DB_HOST empty to store requests in storage/requests.jsonl instead.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Token for the read-only /api/requests JSON feed (e.g. for KWS portal). Empty = disabled.
PORTAL_API_TOKEN=

# Password for /admin/requests (HTTP Basic auth, user "admin"). Empty = page disabled.
ADMIN_PASSWORD=

# Google Analytics 4 measurement ID (leave empty to disable)
GA_MEASUREMENT_ID=G-JJHZYP8C4G

# Store page views in site_events table (needs DB). 1 = on, 0 = off
TRACK_PAGE_VIEWS=1

# Show PHP errors (dev only)
APP_DEBUG=0

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# Leave empty to fall back to Cloudflare's always-pass test keys (dev only).
TURNSTILE_SITE_KEY=0x4AAAAAAFAbNzrSAz9N3TNM
TURNSTILE_SECRET_KEY=
