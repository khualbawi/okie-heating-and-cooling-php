# Okie Heating & Cooling — Apache/LiteSpeed config (Hostinger shared hosting)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + non-www (comment out if Hostinger already handles this)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Block direct access to internal dirs
  RewriteRule ^(includes|pages|sql|storage)(/|$) - [F,L]
  RewriteRule ^(config\.php|\.env|composer\.(json|lock))$ - [F,L]

  # Existing files/dirs are served directly (assets, robots.txt, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> front controller
  RewriteRule ^ index.php [L]
</IfModule>

# =============================================================================
# LiteSpeed full-page cache (Hostinger runs LiteSpeed Web Server)
# HTML is served straight from LiteSpeed's cache, so PHP never runs for a hit.
# Enable "LiteSpeed Cache" for the domain in hPanel for these rules to take effect.
# =============================================================================
<IfModule LiteSpeed>
  CacheLookup on

  # Only cache safe, anonymous GET/HEAD requests.
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule .* - [E=Cache-Control:no-cache]

  # Never cache the admin inbox, the form/telemetry endpoints, or authed requests.
  RewriteCond %{REQUEST_URI} ^/(admin|api)/ [NC]
  RewriteRule .* - [E=Cache-Control:no-cache]

  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=Cache-Control:no-cache]

  # Public pages: 1 day in the LiteSpeed cache. PHP re-asserts this per response
  # via X-LiteSpeed-Cache-Control (includes/cache.php), which wins when present.
  RewriteRule ^$ - [E=Cache-Control:max-age=86400]
  RewriteCond %{REQUEST_URI} !^/(admin|api)/ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule .* - [E=Cache-Control:max-age=86400]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Versioned assets (?v=<mtime>) are safe to cache forever.
  <FilesMatch "\.(css|js|woff2|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
  </FilesMatch>

  # Fonts are fetched with crossorigin because of <link rel=preload as=font>.
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Static asset expiry (fallback when mod_headers is unavailable)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# Correct MIME types (needed for compression + long cache to apply)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression — Brotli first, gzip as the fallback
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/ld+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/ld+json
</IfModule>

ErrorDocument 404 /index.php
